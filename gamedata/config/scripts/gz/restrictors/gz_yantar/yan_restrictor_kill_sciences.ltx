[logic]
active = sr_idle

[sr_idle]
on_info = {+gz_yan_ambush_mine_spawn -yan_sciences_kill} %+find_scien_in_underground_start% sr_idle@10

[sr_idle@10]
on_timer = 12000| sr_idle@2

[sr_idle@2]
on_info = {-yan_sciences_kill} %+yan_sciences_kill =yan_sniper_merc_message_1_1 =del_yan_scienlider% 
on_timer = 4000| sr_idle@3 %=yan_sniper_merc_message_1_2%

[sr_idle@3]
on_timer = 6000| sr_idle@4 %=yan_sniper_merc_message_1_3% 

[sr_idle@4]
on_timer = 12000| %+back_to_scien_lager_fail% sr_idle@5

[sr_idle@5]
on_timer = 2000| %=yan_sniper_merc_message_1_4% sr_idle@6

[sr_idle@6]
on_timer = 10000| nil %+find_scien_in_underground_start +find_scien_in_underground_start_task%