--/Функции для работы диалога с хакером.
function precondition_pda_stalker_novice()
 if actor:object("pda_stalker_novice") then
  return true
 end
end
function action_pda_stalker_novice()
 local obj = actor:object("pda_stalker_novice")
 if obj then 
   selected_pda = obj:section()
 end
end

