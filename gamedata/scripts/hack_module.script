--//Ломаем ПДА
function pda_hack_start()	
 
 hacking_hacker_complete()
 actor:give_money(-3000)
 if selected_pda then
    amk.remove_item_from_inventory_by_name(tostring(selected_pda), db.actor)
 end
end

function hacking_hacker_complete()
 local section_pda = selected_pda
 local level_lock = ini:r_string(section_pda, "encryption_level")
 local encrypt_level = encrypt_to_num[level_lock]
 
 --// Выдача статей энциклопедии
 local new_statja_num = 0 
 local enciclopedy_rnd = math.random(1, encrypt_level)
 for i = 1, enciclopedy_rnd do
     local statja_for_pda = enciclopedy_list[math.random(#enciclopedy_list)]
         if not has_alife_info(statja_for_pda) then
             gz_utils.give_info(statja_for_pda)
             new_statja_num = new_statja_num + 1
         end
 end
 
 --// Выдача уникальных инфопоршей
 if ini:line_exist(section_pda, "unical_info") then 
     local unic_info = ini:r_string(section_pda, "unical_info")
     local t = string.split(unic_info, 1, ",")
         for i = 1, #t, 1 do
		   gz_utils.give_info(i)
		 end
 end
 
 local hacker_name = "Хакер."
 local hacker_sms = table_sms[math.random(#table_sms)]
 local new_encilopedy = game.translate_string("new_entries")
 news_manager.send_tip(actor, "%c[255,255,0,0]"..hacker_name..":\\n%c[255,0,0,220]"..game.translate_string(hacker_sms))
 news_manager.send_tip(actor, "%c[255,0,0,220]"..new_encilopedy.."%c[255,0,220,0] "..new_statja_num)
 gz_treasure_manager.spawn_box(encrypt_level)

end