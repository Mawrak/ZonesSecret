-- Helper: get array of keys from a dictionary table
local function get_keys(t)
	local keys = {}
	for k, _ in pairs(t) do
		table.insert(keys, k)
	end
	return keys
end

-- Precompute key arrays for random selection
local items_keys = get_keys(items_list)
local explode_keys = get_keys(explode_list)

