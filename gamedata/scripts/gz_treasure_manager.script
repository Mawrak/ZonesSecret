--//Необходимый ранг владельца тайника 
local map_to_rank_list = {
	["gz_darkscape"] = 1,
	["gz_darkvalley"] = 1,
	["gz_garbage1935"] = 2,
	["gz_agroprom"] = 2,
	["gz_agroprom_underground"] = 2,
	["gz_yantar"] = 3,
	["gz_red_forest"] = 3,
	["gz_promzone"] = 4,
	["gz_labx13"] = 4
}

function spawn_random_item(rank)
	local tbl = {}

	--// ОРУЖИЕ (40% шанс)
	if math.random(0, 100) > 60 then
		local weapon_true = {}
		for key, value in pairs(weapon_list) do
			if value == rank or value == rank - 1 then
				table.insert(weapon_true, key)
			end
		end
		if #weapon_true > 0 then
			local weapon = weapon_true[math.random(#weapon_true)]
			table.insert(tbl, weapon)

			-- боеприпасы
			for i = 1, math.random(1, rank) do
				if ini:line_exist(weapon, "ammo_class") then
					local ammo_class = ini:r_string(weapon, "ammo_class")
					local ammo_list = string.split(ammo_class, 1, ",")
					table.insert(tbl, ammo_list[math.random(#ammo_list)])
				end
			end

			-- аддоны (если ранг > 2)
			if rank > 2 then
				-- прицел
				if ini:line_exist(weapon, "scope_name") and ini:line_exist(weapon, "scope_status") and math.random(0, 100) > 75 then
					local scope = ini:r_string(weapon, "scope_name")
					local scope_status = ini:r_s32(weapon, "scope_status")
					if scope_status == 2 then
						table.insert(tbl, scope)
					end
				end
				-- глушитель
				if ini:line_exist(weapon, "silencer_name") and ini:line_exist(weapon, "silencer_status") and math.random(0, 100) > 75 then
					local sil = ini:r_string(weapon, "silencer_name")
					local sil_status = ini:r_s32(weapon, "silencer_status")
					if sil_status == 2 then
						table.insert(tbl, sil)
					end
				end
				-- подствольник
				if ini:line_exist(weapon, "grenade_launcher_name") and ini:line_exist(weapon, "grenade_launcher_status") and math.random(0, 100) > 75 then
					local grl = ini:r_string(weapon, "grenade_launcher_name")
					local grl_status = ini:r_s32(weapon, "grenade_launcher_status")
					if grl_status == 2 then
						table.insert(tbl, grl)
						-- патроны для подствольника
						for j = 1, math.random(1, 2 * rank) do
							if ini:line_exist(weapon, "grenade_class") then
								local grenade_class = ini:r_string(weapon, "grenade_class")
								local grenade_class_list = string.split(grenade_class, 1, ",")
								table.insert(tbl, grenade_class_list[math.random(#grenade_class_list)])
							end
						end
					end
				end
			end
		end
	end

	--// БРОНЕЖИЛЕТ (30% шанс)
	if math.random(0, 100) > 70 then
		local outfit_true = {}
		for key, value in pairs(outfit_list) do
			if value == rank or value == rank - 1 then
				table.insert(outfit_true, key)
			end
		end
		if #outfit_true > 0 then
			local outfit = outfit_true[math.random(#outfit_true)]
			table.insert(tbl, outfit)
		end
	end

	--// ПНВ (30% шанс)
	if math.random(0, 100) > 90 then
		local pnv = pnv_list[math.random(#pnv_list)]
		table.insert(tbl, pnv)
	end

	--// ПРЕДМЕТЫ (от 1 до 2*rank разных типов)
	local item_count = math.random(1, 2 * rank)
	local last_item_key = nil
	for i = 1, item_count do
		local item_key = items_keys[math.random(#items_keys)]
		if item_key ~= last_item_key then
			local max_qty = items_list[item_key]
			local qty = math.random(1, max_qty)
			for _ = 1, qty do
				table.insert(tbl, item_key)
			end
			last_item_key = item_key
		end
	end

	--// ВЗРЫВЧАТКА (если ранг >= 2, 50% шанс)
	if rank >= 2 and math.random(0, 100) > 50 then
		local expl_count = math.random(1, rank)
		local last_expl_key = nil
		for i = 1, expl_count do
			local expl_key = explode_keys[math.random(#explode_keys)]
			if expl_key ~= last_expl_key then
				local max_qty = explode_list[expl_key]
				local qty = math.random(1, max_qty)
				for _ = 1, qty do
					table.insert(tbl, expl_key)
				end
				last_expl_key = expl_key
			end
		end
	end

	return tbl
end

function spawn_box(rank)
	local available_sids = {}

	-- собрать все тайники, локация которых подходит по рангу
	for sid, info in pairs(treasure_SID) do
		local map_name = info[1]
		if map_to_rank_list[map_name] and map_to_rank_list[map_name] <= rank then
			table.insert(available_sids, sid)
		end
	end

	if #available_sids == 0 then
		log1("Warning: закончились тайники для НПС " .. rank .. " ранга")
		return
	end

	-- выбрать случайный тайник
	local chosen_sid = available_sids[math.random(#available_sids)]
	local description = game.translate_string(treasure_SID[chosen_sid][2])
	local story_obj = alife():story_object(tonumber(chosen_sid))

	if story_obj == nil then
		log1("SID тайника некорректен! SID = " .. chosen_sid)
		return
	end

	-- отметить на карте
	level.map_add_object_spot_ser(story_obj.id, "treasure", tostring(description))
	gz_caches_map_tip()

	-- создать содержимое
	local item_list = spawn_random_item(rank)
	for _, item_name in ipairs(item_list) do
		alife():create(item_name, story_obj.position, story_obj.m_level_vertex_id, story_obj.m_game_vertex_id, story_obj.id)
	end
end

--' Снимаем отметку с тайника (вызывается, когда игрок забирает предмет)
function take_item_from_box(box, item)
	level.map_remove_object_spot(box:id(), "treasure")
end

function gz_caches_map_tip()
	news_manager.send_tip(db.actor, "%c[255,255,128,128] \\n%c[255,255,0,0] Новая отметка тайника на карте.", 0, "cache_map", 25000)
	local snd = sound_object([[device\pda\pda_news]])
	snd:play_no_feedback(db.actor, sound_object.s2d, 0, vector():set(0, 0, 0), 2.0)
end

-- NOTE: Функции net_spawn / on_before_save удалены, т.к. сохранение использованных SID больше не требуется.